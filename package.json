{
  "name": "umamusume-factor-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:validate": "tsx scripts/validate/snapshot.ts && npm run data:validate:p1 && npm run data:validate:p3",
    "data:validate:p1": "tsx scripts/validate/pedigree.ts",
    "data:import": "tsx scripts/import-reference.ts",
    "data:validate:reference": "tsx scripts/validate/local-reference.ts",
    "data:import:p3": "npm run data:import:p3:base && npm run data:crosscheck:trainers",
    "data:validate:p3": "tsx scripts/validate/skill-support.ts",
    "prebuild": "npm run data:validate",
    "build": "tsc --noEmit && vite build",
    "build:private-assets": "tsc --noEmit && node scripts/assets/build-private.mjs",
    "check": "npm run lint && npm run typecheck && npm run data:validate && npm run test && npm run build",
    "data:collect:p3": "node scripts/collect-p3.mjs",
    "data:refresh:p3": "npm run data:import:p3:base && npm run data:crosscheck:trainers",
    "data:import:p3:legacy": "tsx scripts/import-skill-support.ts",
    "data:validate:p3:local": "tsx scripts/validate/p3-expanded.ts",
    "data:validate:p4": "tsx scripts/validate/p4-recommendation.ts",
    "data:validate:p41": "tsx scripts/validate/p41-comparison.ts && node scripts/validate/p41-integrity.mjs",
    "data:import:p5": "tsx scripts/import-p5.ts",
    "data:validate:p5": "tsx scripts/validate/p5-release-order.ts && tsx scripts/validate/p5-recommendation-policy.ts && tsx scripts/validate/p5-recommendation.ts && tsx scripts/validate/p5-late-release.ts && node scripts/validate/p41-integrity.mjs",
    "data:validate:p6": "tsx scripts/validate/p6-user-skill-priority.ts && node scripts/validate/p41-integrity.mjs",
    "data:validate:p61": "tsx scripts/validate/p61-search-optimality.ts && node scripts/validate/p41-integrity.mjs",
    "data:validate:p7": "tsx scripts/validate/p7-lineage-skills.ts && node scripts/validate/p41-integrity.mjs",
    "data:validate:p8": "tsx scripts/validate/p8-persistence.ts && node scripts/validate/p41-integrity.mjs",
    "data:validate:p85": "tsx scripts/assets/validate-assets.ts && tsx scripts/validate/p85-support-filters.ts && tsx scripts/validate/p85-tournaments.ts && node scripts/validate/p41-integrity.mjs",
    "data:validate:p85:static": "tsx scripts/validate/p85-static-assets.ts",
    "data:validate:p86:static": "tsx scripts/validate/p85-static-assets.ts --p86",
    "data:validate:p86": "node scripts/validate/p86-preservation.mjs",
    "data:assets:p85": "tsx scripts/assets/build-assets.ts",
    "data:assets:p85:public-audit": "tsx scripts/assets/validate-assets.ts --public-release",
    "data:crosscheck:trainers": "tsx scripts/trainers/run.mjs --validate true",
    "data:import:p3:base": "tsx scripts/refresh-p3.mjs",
    "test:trainers": "node --test scripts/trainers/test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
